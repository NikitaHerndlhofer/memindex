{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/vendor",
      "!**/*.gen.ts",
      "!**/.audit",
      "!**/.bench",
      "!**/supabase/.temp",
      "!**/supabase/migrations/meta",
      "!eval-local"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": { "enabled": true, "rules": { "recommended": true } }
}
