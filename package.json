{
  "name": "memindex-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint .",
    "lint:knip": "knip",
    "format": "biome format --write .",
    "postinstall": "bun packages/tokenizer/scripts/fetch.ts",
    "check:tokenizer": "bun scripts/check-tokenizer.ts",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "knip": "^6.42.1",
    "typescript": "^5.9.0"
  }
}
