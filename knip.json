{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "apps/memindex": {
      "entry": ["scripts/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "packages/chunkers": {
      "entry": ["scripts/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "packages/embed": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/engine": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/model": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/sources": {
      "entry": ["scripts/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "packages/tokenizer": {
      "entry": ["scripts/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "packages/store": {
      "entry": ["scripts/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    }
  }
}
